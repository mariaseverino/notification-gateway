# Configurações da Aplicação
NODE_ENV=development
PORT=3333

# Banco de Dados (PostgreSQL)
DB_HOST=postgres
DB_PORT=5432
DB_USER=notification-gateway
DB_PASS=notification-gateway
DB_NAME=notification-gateway

# Cache (Redis)
REDIS_HOST=redis
REDIS_PORT=6379

# Mensageria (RabbitMQ)
RABBITMQ_URL=amqp://notification-gateway:notification-gateway@rabbitmq:5672

# Envio de E-mails (MailHog)
MAILHOG_HOST=mailhog
MAILHOG_PORT=1025